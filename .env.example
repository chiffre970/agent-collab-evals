# Copy this file to .env for local development. Never commit .env or real
# credentials. The committed values below are non-secret calibration defaults.

# Modal CLI authentication is stored outside this repository by `modal setup`
# in ~/.modal.toml. Use a profile name when a non-default profile is needed.
MODAL_PROFILE=
MODAL_ENVIRONMENT=dev
MODAL_HF_SECRET_NAME=huggingface-secret

# OpenRouter supplies the coding-agent model. The dated model and exact
# zero-data-retention inference provider are pinned here so a preflight cannot
# silently route to a different backend or weaken the account privacy policy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PROVIDER=DeepInfra
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_COMPLETION_TOKENS=512
OPENROUTER_APP_TITLE=agent-collab-evals
OPENROUTER_HTTP_REFERER=

# The separate open-weight serving target. This immutable commit matches the
# calibration campaign pack; changing it creates a different scenario version.
TARGET_MODEL_ID=Qwen/Qwen3-4B
TARGET_MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
TARGET_GPU=L4

# Optional direct providers for later registered study profiles.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional headless/CI Modal authentication. Prefer `modal setup` locally.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
