# Copy this file to .env for local development. Never commit .env or real credentials.

# Modal CLI authentication is stored outside this repository by `modal setup`
# in ~/.modal.toml. Use a profile name when a non-default profile is needed.
MODAL_PROFILE=chiffre970

# Provider credentials: fill only the credentials required by the selected study.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional headless/CI Modal authentication. Prefer `modal setup` locally.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
