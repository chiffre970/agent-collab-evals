{
  "name": "agent-collab-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:provider-route": ".venv/bin/python scripts/preflight/provider_route_qualification.py",
    "snapshot:provider-sources": "node --env-file=.env scripts/preflight/provider_source_snapshot.mjs",
    "qualify:provider-route": "node --env-file=.env scripts/preflight/provider_route_qualification.mjs",
    "retain:provider-route": ".venv/bin/python scripts/preflight/retain_provider_qualification.py",
    "check:openrouter": "node --check scripts/preflight/openrouter.mjs && node scripts/preflight/openrouter.mjs --validate-profile",
    "check:opencode": "node --check scripts/runtime/opencode_conformance.mjs && node --check scripts/runtime/opencode_bridge.mjs && node --check scripts/runtime/peer_tool_server.mjs && node --check scripts/runtime/peer_tool_conformance.mjs",
    "check:model-gateway": ".venv/bin/python scripts/preflight/model_gateway_live.py",
    "preflight:model-gateway": "node --env-file=.env scripts/preflight/model_gateway_live.mjs",
    "spike:opencode": "node scripts/runtime/opencode_conformance.mjs",
    "preflight:openrouter": "node --env-file=.env scripts/preflight/openrouter.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode-ai/sdk": "1.18.19",
    "@openrouter/sdk": "1.2.34",
    "opencode-ai": "1.18.19",
    "zod": "4.4.3"
  }
}
