{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-serving-candidate/v0alpha2",
  "title": "Model serving candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "model",
    "resource",
    "build",
    "server"
  ],
  "properties": {
    "schema_version": {
      "const": "model-serving-candidate/v0alpha2"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_type", "gpu_count"],
      "properties": {
        "gpu_type": {"type": "string", "minLength": 1},
        "gpu_count": {"type": "integer", "minimum": 1}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_ref", "image_digest", "dependency_lock"],
      "properties": {
        "image_ref": {"type": "string", "minLength": 1},
        "image_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "dependency_lock": {"type": "string", "minLength": 1}
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "engine_args",
        "port",
        "health_path",
        "chat_path",
        "served_model_name",
        "generation_config"
      ],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "engine_args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dtype",
            "max_model_len",
            "gpu_memory_utilization_ppm",
            "stream_interval",
            "max_num_seqs",
            "max_num_batched_tokens",
            "enforce_eager",
            "disable_log_stats"
          ],
          "properties": {
            "dtype": {"const": "bfloat16"},
            "max_model_len": {"type": "integer", "minimum": 4096, "maximum": 32768},
            "gpu_memory_utilization_ppm": {"type": "integer", "minimum": 100000, "maximum": 950000},
            "stream_interval": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_num_seqs": {
              "oneOf": [
                {"type": "null"},
                {"type": "integer", "minimum": 1, "maximum": 1024}
              ]
            },
            "max_num_batched_tokens": {
              "oneOf": [
                {"type": "null"},
                {"type": "integer", "minimum": 1024, "maximum": 131072}
              ]
            },
            "enforce_eager": {"type": "boolean"},
            "disable_log_stats": {"const": true}
          }
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "health_path": {"type": "string", "pattern": "^/"},
        "chat_path": {"type": "string", "pattern": "^/"},
        "served_model_name": {"type": "string", "minLength": 1},
        "generation_config": {"enum": ["vllm", "explicit"]}
      }
    }
  }
}
